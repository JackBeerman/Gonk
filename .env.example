# Copy to .env and fill in. Never commit .env.

# Space-Track.org account (free: https://www.space-track.org/auth/createAccount)
SPACETRACK_USER=you@example.com
SPACETRACK_PASS=your-space-track-password

# Email delivery (optional; without it the report is only written to ./reports)
# Gmail: smtp.gmail.com, port 587, and an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com,colleague@example.com

# Optional: radio-frequency lookups from SatNOGS DB (set GONK_SATNOGS=0 to turn off)
# SATNOGS_API_TOKEN=
